    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.531"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.531",
    "@remotion/renderer": "4.0.531",
    "@types/react": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
